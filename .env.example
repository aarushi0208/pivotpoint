# Create a .env file in the project root and set your key there.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
# Use this to configure any self-referential links or callbacks if needed.
APP_URL="MY_APP_URL"
